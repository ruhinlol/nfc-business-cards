<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600" width="1200" height="600">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2D1F17" />
      <stop offset="50%" stop-color="#543D2B" />
      <stop offset="100%" stop-color="#8B6F47" />
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#D4A373" stop-opacity="0.4" />
      <stop offset="100%" stop-color="#000000" stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect width="1200" height="600" fill="url(#bgGrad)" />
  <circle cx="600" cy="300" r="400" fill="url(#glow)" />
  
  <!-- Subtle decorative ambient waves -->
  <path d="M0 500 Q300 420 600 500 T1200 500 L1200 600 L0 600 Z" fill="#1E140E" opacity="0.6"/>
  <path d="M0 540 Q300 480 600 540 T1200 540 L1200 600 L0 600 Z" fill="#140D09" opacity="0.8"/>

  <!-- Center Typography -->
  <text x="600" y="270" font-family="'Inter', sans-serif" font-size="54" font-weight="800" fill="#FFFFFF" text-anchor="middle" letter-spacing="4">COFFEE RIVERMANIA</text>
  <text x="600" y="325" font-family="'Inter', sans-serif" font-size="24" font-weight="500" fill="#D4A373" text-anchor="middle" letter-spacing="2">MINGƏÇEVİR • QƏHVƏ VƏ DESERT</text>
</svg>
